{
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ],
  "redirects": [
    { "source": "/ua", "destination": "/ua/index.html", "permanent": false },
    { "source": "/ru", "destination": "/ru/index.html", "permanent": false }
  ]
}
